[Unit]
Description=gunicorn daemon
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/home/user/olimpiad-backend/backend/backend
ExecStart=/home/user/olimpiad-backend/backend/venv/bin/gunicorn --workers 3 --bind unix:/home/user/olimpiad-backend/backend/backend/gunicorn.sock backend.wsgi:application

[Install]
WantedBy=multi-user.target
