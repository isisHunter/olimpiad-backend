
server {
	listen 443 ssl;
	ssl_certificate /etc/ssl/rosolympiad.ru.crt;
	ssl_certificate_key /etc/ssl/rosolympiad.ru.key;
	
	index index.html index.htm index.nginx-debian.html;

	server_name rosolympiad.ru www.rosolympiad.ru;

	location / {
		root /home/user/olimpiad-backend/frontend/build;
		index index.html;
		try_files $uri $uri /index.html;
	}

	location /api/ {
		proxy_pass http://unix:/home/user/olimpiad-backend/backend/backend/gunicorn.sock;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}
}
server {
	listen 80;
        listen [::]:80;
	server_name rosolympiad.ru www.rosolympiad.ru;
        return 301 https://$server_name$request_uri;
}